# Copy to .env; placeholders only. SQLite is the local no-Docker fallback.
DATABASE_URL=sqlite:///./newsmind.db
DEMO_MODE=true
NEWSAPI_KEY=
NEWS_PROVIDER=rss
RSS_FEEDS=ndtv-india|ndtv-world|ndtv-sports|gadgets360|hindu-tamilnadu|bbc-world|bbc-sports|bbc-technology|bbc-politics
AI_PROVIDER=none
OPENAI_API_KEY=
AI_MODEL=gpt-5-mini
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPS_TOKEN=
FETCH_INTERVAL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=300
# Supabase must use asymmetric JWT signing keys (ES256 or RS256).
SUPABASE_URL=
